#!/usr/bin/env python3
"""Ranchr host: tunnel and magic-link QR."""

from __future__ import annotations

import json
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import urlencode
ROOT = Path(__file__).resolve().parent.parent
PORT = int(os.environ.get("HERD_PORT", "8787"))
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "ranchr"
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "ranchr/config.json"
HOST_PATH = STATE_DIR / "host.json"
QR_PATH = STATE_DIR / "qr.png"
DEFAULT_CONFIG = {
    "app_url": "https://scttymn.github.io/ranchr",
}

# binary name → Arch package. Both are extra/ on Omarchy.
DEPS = (
    ("cloudflared", "cloudflared"),
    ("qrencode", "qrencode"),
)


def load_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def save_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    tmp.replace(path)


def config() -> dict:
    cfg = dict(DEFAULT_CONFIG)
    cfg.update(load_json(CONFIG_PATH, {}))
    return cfg


def host_state() -> dict:
    return load_json(HOST_PATH, {"on": False})


def port_open() -> bool:
    sock = socket.socket()
    sock.settimeout(0.3)
    try:
        sock.connect(("127.0.0.1", PORT))
        return True
    except OSError:
        return False
    finally:
        sock.close()


def _proc_start(pid: int) -> float:
    try:
        return os.stat(f"/proc/{pid}").st_ctime
    except OSError:
        return 0.0


def ensure_gateway() -> None:
    script = ROOT / "gateway.py"
    st = host_state()
    pid = st.get("gateway_pid")
    if port_open() and pid:
        try:
            os.kill(int(pid), 0)
            if script.stat().st_mtime <= _proc_start(int(pid)) + 1:
                return
        except (ProcessLookupError, FileNotFoundError, TypeError, ValueError, OSError):
            pass
        kill_pid(int(pid))
        for _ in range(30):
            if not port_open():
                break
            time.sleep(0.1)
    log = STATE_DIR / "gateway.log"
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with log.open("ab") as fh:
        proc = subprocess.Popen(
            [sys.executable, str(ROOT / "gateway.py")],
            cwd=str(ROOT),
            stdout=fh,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    for _ in range(40):
        if port_open():
            st = host_state()
            st["gateway_pid"] = proc.pid
            save_json(HOST_PATH, st)
            return
        time.sleep(0.1)
    raise SystemExit("gateway did not start on 127.0.0.1:%s" % PORT)


def kill_pid(pid: int | None) -> None:
    if not pid:
        return
    try:
        os.kill(pid, 15)
    except ProcessLookupError:
        return
    for _ in range(20):
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.05)
    try:
        os.kill(pid, 9)
    except ProcessLookupError:
        return


def start_tunnel():
    if not shutil.which("cloudflared"):
        raise SystemExit("cloudflared is not installed")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log = STATE_DIR / "tunnel.log"
    # Log to a file, not a pipe: when this CLI exits a pipe would SIGPIPE
    # cloudflared and the trycloudflare URL would go dead.
    with log.open("wb") as fh:
        proc = subprocess.Popen(
            [
                "cloudflared",
                "tunnel",
                "--url",
                f"http://127.0.0.1:{PORT}",
                "--no-autoupdate",
            ],
            stdout=fh,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    deadline = time.time() + 45
    buf = ""
    with log.open("rb") as reader:
        while time.time() < deadline:
            if proc.poll() is not None:
                rest = reader.read().decode("utf-8", "replace")
                raise SystemExit("cloudflared exited:\n" + (buf + rest)[-2000:])
            chunk = reader.read().decode("utf-8", "replace")
            if not chunk:
                time.sleep(0.1)
                continue
            buf += chunk
            found = re.search(r"https://[a-z0-9-]+\.trycloudflare\.com", buf)
            if found:
                return found.group(0), proc.pid
    kill_pid(proc.pid)
    raise SystemExit("timed out waiting for trycloudflare URL")


def write_qr(magic: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if not shutil.which("qrencode"):
        return
    subprocess.check_call(
        ["qrencode", "-o", str(QR_PATH), "-s", "8", "-m", "2", magic]
    )


def cmd_status() -> int:
    st = host_state()
    st["gateway"] = port_open()
    st["qr"] = str(QR_PATH) if QR_PATH.is_file() else ""
    st["config"] = config()
    json.dump(st, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


def app_url() -> str:
    return (config().get("app_url") or DEFAULT_CONFIG["app_url"]).rstrip("/")


def magic_link(tunnel: str, token: str) -> str:
    query = urlencode({"host": tunnel.rstrip("/"), "t": token})
    return f"{app_url()}/?{query}"


def cmd_on() -> int:
    st = host_state()
    kill_pid(st.get("tunnel_pid"))
    ensure_gateway()
    url, tunnel_pid = start_tunnel()
    token = secrets.token_urlsafe(24)
    magic = magic_link(url, token)
    write_qr(magic)
    st = {
        "on": True,
        "url": url,
        "token": token,
        "magic": magic,
        "tunnel_pid": tunnel_pid,
        "gateway_pid": host_state().get("gateway_pid"),
        "error": None,
    }
    save_json(HOST_PATH, st)
    print(json.dumps({"ok": True, "magic": magic, "error": st.get("error")}))
    return 0


def cmd_off() -> int:
    st = host_state()
    kill_pid(st.get("tunnel_pid"))
    if QR_PATH.is_file():
        QR_PATH.unlink()
    st.update({"on": False, "url": "", "token": "", "magic": "", "tunnel_pid": None, "error": None})
    save_json(HOST_PATH, st)
    print(json.dumps({"ok": True, "on": False}))
    return 0


def cmd_config(args: list[str]) -> int:
    cfg = config()
    if not args:
        json.dump(cfg, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0
    if args[0] == "set" and len(args) >= 3:
        key, value = args[1], " ".join(args[2:])
        if key not in DEFAULT_CONFIG:
            raise SystemExit(f"unknown key {key}")
        cfg[key] = value
        save_json(CONFIG_PATH, cfg)
        json.dump(cfg, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0
    raise SystemExit("usage: ranchr config [set KEY VALUE]")


def cmd_deps(args: list[str]) -> int:
    present = {binary: bool(shutil.which(binary)) for binary, _pkg in DEPS}
    missing = [binary for binary, ok in present.items() if not ok]
    packages = [pkg for binary, pkg in DEPS if binary in missing]
    if args and args[0] == "install":
        if not packages:
            print(json.dumps({"ok": True, "missing": []}))
            return 0
        if not shutil.which("omarchy"):
            raise SystemExit("omarchy is not on PATH; install: pacman -S --needed " + " ".join(packages))
        return subprocess.call(["omarchy", "pkg", "add", *packages])
    body = {
        **present,
        "ready": not missing,
        "missing": missing,
        "packages": packages,
    }
    json.dump(body, sys.stdout)
    sys.stdout.write("\n")
    return 0


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print("ranchr host on|off|status")
        print("ranchr config [set KEY VALUE]")
        print("ranchr deps [install]")
        return 0
    cmd = sys.argv[1]
    if cmd == "host":
        sub = sys.argv[2] if len(sys.argv) > 2 else "status"
        if sub == "on":
            return cmd_on()
        if sub == "off":
            return cmd_off()
        if sub == "status":
            return cmd_status()
        raise SystemExit("usage: ranchr host on|off|status")
    if cmd == "config":
        return cmd_config(sys.argv[2:])
    if cmd == "deps":
        return cmd_deps(sys.argv[2:])
    if cmd in ("on", "off", "status"):
        sys.argv.insert(1, "host")
        return main()
    raise SystemExit("unknown command")


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
